# Multi-stage build for React client only
# This image contains ONLY the React frontend served by nginx (no Go backend)

# Stage 1: Build the React application
FROM node:24-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package.json only (package-lock.json excluded to avoid private registry URLs)
COPY client/package.json ./

# Install ALL dependencies from public npm registry (need devDeps for build)
RUN npm config set registry https://registry.npmjs.org/ && \
    npm install

# Copy client source code
COPY client/ .

# Build the application (Vite outputs to dist/)
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

# Add metadata labels
LABEL maintainer="Slava Kukuyev"
LABEL description="Elevator Control System - React Client"
LABEL version="1.0"

# Copy built files from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration for SPA + backend proxy
COPY client/nginx.conf /etc/nginx/nginx.conf

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
